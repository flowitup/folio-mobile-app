{
  "name": "folio-mobile-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "api:types": "openapi-typescript ./openapi/folio-openapi.json -o ./src/api/generated/schema.d.ts"
  },
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo/vector-icons": "^15.1.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-community/datetimepicker": "9.1.0",
    "@tanstack/react-query": "^5.102.8",
    "expo": "~57.0.19",
    "expo-asset": "~57.0.16",
    "expo-constants": "~57.0.17",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "^57.0.3",
    "expo-image-picker": "~57.0.15",
    "expo-linking": "~57.0.9",
    "expo-localization": "~57.0.1",
    "expo-print": "~57.0.1",
    "expo-router": "~57.0.18",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.17",
    "expo-status-bar": "~57.0.1",
    "i18next": "^26.4.2",
    "nativewind": "^4.2.6",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.3",
    "react-i18next": "^17.0.13",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.1",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^57.0.10",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "jest": "^30.5.1",
    "jest-expo": "^57.0.5",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^3.4.19",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ]
  }
}
