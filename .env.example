# Base URL of the Folio backend API (no trailing slash). Leave unset for a local
# backend (github.com/flowitup/folio-back-end on port 5000): the app uses
# http://localhost:5000 on the iOS simulator and http://10.0.2.2:5000 on the Android
# emulator (src/config/env.ts). Set it only to reach another backend.
# EXPO_PUBLIC_API_BASE_URL=https://folio.flowitup.com
